---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---
<BaseLayout portal title="友情链接"><div class="portal-shell collection-shell"><header class="collection-heading"><p class="eyebrow">A FEW GOOD PLACES</p><h1>友情链接</h1><p>在这里，与更多有趣的记录相遇。</p></header>{site.friends.length ? <div class="friend-grid">{site.friends.map(friend=><a class="panel friend-item" href={friend.href} target="_blank" rel="noopener noreferrer"><span class="friend-initial" aria-hidden="true">{friend.name.slice(0,1)}</span><div><h2>{friend.name} <span aria-hidden="true">↗</span></h2><p>{friend.description}</p></div></a>)}</div> : <section class="panel collection-empty"><span aria-hidden="true">↗</span><h2>留一个位置，给下一次相遇。</h2><p>暂时还没有添加友链。</p></section>}</div></BaseLayout>
